    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  },
  "scripts": {
    "prepare": "sh scripts/ensure-git-hooks.sh",
    "start": "node scripts/expo-start.mjs",
    "android": "node scripts/expo-start.mjs --android",
    "ios": "node scripts/expo-start.mjs --ios",
    "web": "expo start --web --clear",
    "lint": "expo lint",
    "fmt:check:changed": "sh scripts/check-format-changed.sh",
    "check:vocabulary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-vocabulary.mjs",
    "notices:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs",
    "notices:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs --check --js-only",
    "notices:check:native": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs --check --native",
    "eas-build-post-install": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs --native",
    "eas:update": "EXPO_PUBLIC_GIT_COMMIT=$(git rev-parse HEAD) eas update",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:low-mem": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "verify:ci": "pnpm check:vocabulary && pnpm notices:check && pnpm typecheck && pnpm test:coverage",
    "test:coverage:low-mem": "vitest run --coverage --maxWorkers=1 --no-file-parallelism",
    "os-logos": "node scripts/render-os-logos.mjs",
    "export": "expo export --platform web",
    "deploy": "node scripts/deploy-refuse.mjs",
    "deploy:testing": "wrangler deploy --env testing",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:live": "wrangler deploy --env live",
    "cf-typegen": "wrangler types"
  },
  "private": true,
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
