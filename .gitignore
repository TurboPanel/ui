# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Node/pnpm-only — never commit Deno lockfiles
deno.lock

# Tamagui generated component cache (regenerate locally during builds)
.tamagui/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
.cache/
.local/
.config/
logs/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env and secret-bearing dotenv variants
.env
.env.*
.env-*
.envrc
!.env.example
.dev.vars
.dev.vars*
!.dev.vars.example

# keys, certs, tokens, and passwords
*.token
*.secret
*.pass
server-key.json
license.token
certs/

# typescript
*.tsbuildinfo

# Vitest coverage (`pnpm test:coverage` → coverage/lcov.info)
coverage/

example

# generated native folders
/ios
/android

.pnpm-store/
# co-located dev host stamp (normalize-dev-checkout.sh)
.turbopanel-checkout-stamp

# Python bytecode (ui-ux-pro-max skill scripts)
__pycache__/
*.py[cod]
*$py.class
.agents/skills/**/__pycache__/
.agents/skills/**/*.pyc
