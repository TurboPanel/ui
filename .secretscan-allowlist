# Exact allowlisted lines only; do not add broad wildcards.
# Format: path:full line text (exact, no line number; must match the file line exactly).
# Every entry needs a '# reason:' comment above it; a reason covers the entries below it
# up to the next blank line or '# reason:' comment. See scripts/scan-secrets.sh.

# reason: names a secret-bearing file path (docs, config, tests); the file itself is never committed
.gitignore:server-key.json
.gitignore:license.token
