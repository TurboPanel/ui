{
  "expo": {
    "name": "TurboPanel",
    "slug": "ui",
    "version": "0.1.0",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "turbopanel",
    "ios": {
      "bundleIdentifier": "app.turbopanel"
    },
    "android": {
      "package": "app.turbopanel"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f9d64b9-bb2c-425b-9129-606410578108"
      }
    },
    "owner": "turbopanel"
  }
}
