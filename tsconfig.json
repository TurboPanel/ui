{
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    // Prefer a bare module when it exists (package entrypoints + stubs), then
    // platform suffixes so `tsc` can resolve `./compose-yaml-editor` like Metro.
    // Bare-first also keeps `react-native-svg` on its non-web typings — `.web`
    // first made Defs reject children and Svg style reject AbsoluteFillStyle.
    "moduleSuffixes": ["", ".native", ".web"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
