    "eas-build-post-install": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs --native",
    "eas:update": "EXPO_PUBLIC_GIT_COMMIT=$(git rev-parse HEAD) eas update",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:low-mem": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "test:coverage:low-mem": "vitest run --coverage --maxWorkers=1 --no-file-parallelism",
    "os-logos": "node scripts/render-os-logos.mjs",
    "export": "expo export --platform web",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
