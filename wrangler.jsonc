{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "account_id": "a574c2793baa3e2276ac16e96097bc8c",
  // Top-level = local `wrangler dev` only. Every real environment is an `env.*`
  // entry with its own name, so a deploy without `--env` can never hit production.
  "name": "dev-ui",
  "compatibility_date": "2026-06-01",
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "testing": {
      "name": "testing-ui",
      "route": {
        "pattern": "testing.turbopanel.dev",
        "custom_domain": true
      }
    },
    // Staging: the release-candidate environment (deployed from the `staging`
    // branch). The ui Worker holds the apex as a custom domain; the instance
    // Worker's routes (turbopanel `env.staging`) take /api/*, /ws/* and /webhook/*.
    "staging": {
      "name": "staging-ui",
      "route": {
        "pattern": "staging.turbopanel.dev",
        "custom_domain": true
      }
    },
    "live": {
      "name": "ui",
      "route": {
        "pattern": "turbopanel.app",
        "custom_domain": true
      }
    }
  }
}
