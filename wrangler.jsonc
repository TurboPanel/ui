{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-01",
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "pnpm expo export --platform web",
    "cwd": ".",
    "watch_dir": ["src/"]
  },
  "name": "turbopanel-ui",
  "workers_dev": false,
  "env": {
    // Add testing, staging, and live routes/custom domains here later.
  }
}
